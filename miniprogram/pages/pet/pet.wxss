/* pages/pet —— Tab2：宠物（第二阶段）
   视觉基线：design-宠物tab-原型.html（v2.4 定稿）
   度量：设计稿 390px 宽 ⇒ 1px ≈ 1.923rpx */

/* —— 色值豁免声明（P2 打磨补记）——
   本文件中的硬编码色值（渐变端点 / 液体 / 玻璃高光 / 阴影等）均为有意豁免：
   经资产审计与原型 v2.4 逐处比对一致，非配色漂移，改前须比对原型。
   调色板体系变量统一在 app.wxss 定义，禁止改配色体系；新增色值须同样注明豁免来源。 */

/* 顶卡：星星余额 + 连续互动胶囊 */
.topcard {
  margin-top: 27rpx;
  /* 豁免：与原型 v2.4 一致 —— 顶卡奶油渐变端点 */
  background: linear-gradient(135deg, #fff6d8, #ffe9ef);
  border-radius: var(--r);
  padding: 31rpx;
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
}
.topcard .blob { position: absolute; border-radius: 50%; filter: blur(2rpx); opacity: .6; }
.topcard .b1 { width: 154rpx; height: 154rpx; background: var(--sun); right: -35rpx; top: -42rpx; }
.topcard .b2 { width: 104rpx; height: 104rpx; background: var(--coral); left: -31rpx; bottom: -38rpx; opacity: .4; }
.topcard .num { font-size: 81rpx; color: var(--star); line-height: 1; }
.topcard .unit { font-size: 35rpx; color: #c79a2e; /* 豁免：与原型 v2.4 一致 —— 深金文字 */ margin-bottom: 12rpx; }
.topcard .spk { font-size: 62rpx; animation: bob 2.4s ease-in-out infinite; }
@keyframes bob { 0%,100% { transform: translateY(0) rotate(-3deg); } 50% { transform: translateY(-12rpx) rotate(3deg); } }
.streak .go { margin-left: 6rpx; opacity: .7; font-size: 23rpx; }
.streak .fl { animation: flick 1.6s ease-in-out infinite; }
@keyframes flick { 0%,100% { transform: scale(1); } 50% { transform: scale(1.2) rotate(-4deg); } }

/* 宠物舞台 */
.arena {
  margin-top: 31rpx;
  /* 豁免：与原型 v2.4 一致 —— 舞台薄荷/天蓝渐变端点 */
  background: linear-gradient(160deg, #eafff4, #e9f3ff);
  border-radius: var(--r);
  padding: 35rpx 27rpx 38rpx;
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
  text-align: center;
}
.arena .deco2 { position: absolute; left: 0; right: 0; top: 12rpx; text-align: center; font-size: 35rpx; opacity: .45; }

/* ===== HUD：玻璃瓶（成长=心型红瓶 / 心情=水晶蓝瓶），暗黑式左右对称常驻 =====
   豁免：与原型 v2.4 一致 —— 本区块全部硬编码色（瓶身玻璃 rgba 白、成长红/心情蓝液面渐变、
   钻石切面白线、玻璃内壁阴影、气泡白）均为定稿色，改前须比对原型。
   填充口径：成长瓶按「到下一阶段」的阶段内进度（每投喂一次液面可见上升）；
   心情瓶按 mood/100（每抚摸一次 +6 液面）。未领养时也是空瓶，瓶身不消失。 */
.hud2 {
  margin-top: 19rpx;
  display: flex; align-items: flex-end; justify-content: space-between;
}
.flask { width: 116rpx; display: flex; flex-direction: column; align-items: center; }
/* 无瓶盖：成长瓶＝玻璃心，心情瓶＝玻璃钻石（用户 2026-09-19 定稿） */
.flask .body {
  position: relative; width: 104rpx; height: 112rpx; overflow: hidden;
  background: linear-gradient(180deg, rgba(255, 255, 255, .75), rgba(255, 255, 255, .3));
  box-shadow: 0 10rpx 22rpx rgba(80, 90, 130, .22);
}
/* 心型瓶（成长）：参数方程 16sin³t / 13cos t−5cos2t−2cos3t−cos4t 采样 44 点 */
.flask.heart .body {
  -webkit-clip-path: polygon(50.0% 23.8%, 50.1% 22.4%, 51.1% 18.4%, 53.6% 12.9%, 57.9% 7.2%, 64.0% 2.5%, 71.6% 0.0%, 79.8% 0.4%, 87.6% 3.9%, 94.2% 10.1%, 98.5% 18.1%, 100.0% 27.3%, 98.5% 36.7%, 94.2% 45.9%, 87.6% 54.6%, 79.8% 62.9%, 71.6% 70.6%, 64.0% 78.0%, 57.9% 84.9%, 53.6% 91.0%, 51.1% 95.8%, 50.1% 98.9%, 50.0% 100.0%, 49.9% 98.9%, 48.9% 95.8%, 46.4% 91.0%, 42.1% 84.9%, 36.0% 78.0%, 28.4% 70.6%, 20.2% 62.9%, 12.4% 54.6%, 5.8% 45.9%, 1.5% 36.7%, 0.0% 27.3%, 1.5% 18.1%, 5.8% 10.1%, 12.4% 3.9%, 20.2% 0.4%, 28.4% 0.0%, 36.0% 2.5%, 42.1% 7.2%, 46.4% 12.9%, 48.9% 18.4%, 49.9% 22.4%);
  clip-path: polygon(50.0% 23.8%, 50.1% 22.4%, 51.1% 18.4%, 53.6% 12.9%, 57.9% 7.2%, 64.0% 2.5%, 71.6% 0.0%, 79.8% 0.4%, 87.6% 3.9%, 94.2% 10.1%, 98.5% 18.1%, 100.0% 27.3%, 98.5% 36.7%, 94.2% 45.9%, 87.6% 54.6%, 79.8% 62.9%, 71.6% 70.6%, 64.0% 78.0%, 57.9% 84.9%, 53.6% 91.0%, 51.1% 95.8%, 50.1% 98.9%, 50.0% 100.0%, 49.9% 98.9%, 48.9% 95.8%, 46.4% 91.0%, 42.1% 84.9%, 36.0% 78.0%, 28.4% 70.6%, 20.2% 62.9%, 12.4% 54.6%, 5.8% 45.9%, 1.5% 36.7%, 0.0% 27.3%, 1.5% 18.1%, 5.8% 10.1%, 12.4% 3.9%, 20.2% 0.4%, 28.4% 0.0%, 36.0% 2.5%, 42.1% 7.2%, 46.4% 12.9%, 48.9% 18.4%, 49.9% 22.4%);
}
/* 玻璃钻石（心情）：明亮式切割轮廓——台面 + 冠部 + 腰线 + 亭部收尖 */
.flask.diamond .body {
  -webkit-clip-path: polygon(30% 0%, 70% 0%, 100% 32%, 84% 42%, 50% 100%, 16% 42%, 0% 32%);
  clip-path: polygon(30% 0%, 70% 0%, 100% 32%, 84% 42%, 50% 100%, 16% 42%, 0% 32%);
}
/* 钻石切面线：腰线 + 台面两侧竖线 + 亭部汇聚到底尖的两条棱 */
.flask .facet {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  pointer-events: none; z-index: 2;
  background:
    linear-gradient(180deg, transparent 31.2%, rgba(255, 255, 255, .7) 31.6%, rgba(255, 255, 255, .7) 32.4%, transparent 32.8%),
    linear-gradient(90deg, transparent 29.6%, rgba(255, 255, 255, .45) 30%, rgba(255, 255, 255, .45) 30.6%, transparent 31%),
    linear-gradient(90deg, transparent 69.4%, rgba(255, 255, 255, .45) 69.8%, rgba(255, 255, 255, .45) 70.4%, transparent 70.8%);
}
.flask .facet::before, .flask .facet::after {
  content: ''; position: absolute; top: 32%; width: 84%; height: 2rpx;
  background: rgba(255, 255, 255, .5);
}
.flask .facet::before { left: 0; transform-origin: 0 50%; transform: rotate(53.7deg); }
.flask .facet::after { right: 0; transform-origin: 100% 50%; transform: rotate(-53.7deg); }
/* 玻璃内壁：高光内圈 + 底部暗角（被 clip-path 裁成瓶形） */
.flask .body::after {
  content: ''; position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  box-shadow: inset 0 0 0 5rpx rgba(255, 255, 255, .82), inset 0 -14rpx 22rpx rgba(90, 100, 150, .18);
  pointer-events: none;
}
.flask .liquid {
  position: absolute; left: 0; right: 0; bottom: 0;
  transition: height .6s cubic-bezier(.34, 1.4, .5, 1);
}
.flask .liquid.growth {
  background: linear-gradient(180deg, #ffa3b0 0%, #ff5d6c 45%, #e33e58 100%);
  box-shadow: 0 -4rpx 14rpx rgba(255, 110, 130, .55);
}
.flask .liquid.mood {
  background: linear-gradient(180deg, #95e2ff 0%, #46b6ff 45%, #2f7fe0 100%);
  box-shadow: 0 -4rpx 14rpx rgba(70, 180, 255, .5);
}
/* 液面：高光椭圆 + 轻微起伏 */
.flask .liquid::before {
  content: ''; position: absolute; left: -8%; right: -8%; top: -7rpx; height: 15rpx;
  border-radius: 50%; background: rgba(255, 255, 255, .6);
  animation: wave 2.6s ease-in-out infinite;
}
@keyframes wave {
  0%, 100% { transform: translateY(0) scaleX(1); }
  50% { transform: translateY(-4rpx) scaleX(1.08); }
}
.flask .shine {
  position: absolute; left: 10%; top: 8%; width: 24%; height: 72%;
  border-radius: 999rpx; transform: rotate(8deg);
  background: linear-gradient(180deg, rgba(255, 255, 255, .85), rgba(255, 255, 255, .12));
  pointer-events: none;
}
.flask .bub {
  position: absolute; width: 10rpx; height: 10rpx; border-radius: 50%;
  background: rgba(255, 255, 255, .65); animation: rise 3s ease-in infinite;
}
.flask .bub.b1 { left: 26%; bottom: 10%; animation-delay: .2s; }
.flask .bub.b2 { left: 60%; bottom: 22%; width: 8rpx; height: 8rpx; animation-delay: 1.4s; }
@keyframes rise {
  0% { transform: translateY(0); opacity: 0; }
  20% { opacity: .85; }
  100% { transform: translateY(-58rpx); opacity: 0; }
}
/* 数字放「瓶身中下部」：心形与钻石底部都收尖，贴底会被 clip-path 裁掉
   P1 打磨「描边提号」定稿：21rpx 白字 → 24rpx 深字（基线文本色 var(--ink)）+ 白描边，
   液面（红/蓝）与玻璃白底两种背景、以及液面低于数字位时均可读。
   豁免：白描边 #fff / 投影 rgba —— 与原型 v2.4 玻璃高光同源白 */
.flask .fnum {
  position: absolute; left: 0; right: 0; bottom: 36rpx; text-align: center;
  font-size: 24rpx; font-weight: 800; color: var(--ink); z-index: 3;
  text-shadow:
    -2rpx -2rpx 0 #fff, 2rpx -2rpx 0 #fff, -2rpx 2rpx 0 #fff, 2rpx 2rpx 0 #fff,
    -2rpx 0 0 #fff, 2rpx 0 0 #fff, 0 -2rpx 0 #fff, 0 2rpx 0 #fff,
    0 3rpx 6rpx rgba(50, 40, 70, .35);
}
.flask .flab { margin-top: 8rpx; font-size: 21rpx; font-weight: 700; color: #4b5a72; /* 豁免：与原型 v2.4 一致 —— 瓶标深灰蓝 */ }

/* 宠物本体 */
/* 豁免：与原型 v2.4 一致 —— 本区块硬编码色（腮红珊瑚 rgba、破壳提示橙 #e8762f、传奇横幅白字）均为定稿色 */
.pet-stage { height: 365rpx; display: flex; align-items: center; justify-content: center; position: relative; }
.pet-wrap { position: relative; display: flex; align-items: center; justify-content: center; }
.pet { font-size: 185rpx; line-height: 1; filter: drop-shadow(0 23rpx 35rpx rgba(120, 110, 160, .25)); transition: transform .3s; }
.pet.egg { font-size: 162rpx; }
.pet.s1 { animation: wob 2.2s ease-in-out infinite; }
.pet.s2 { font-size: 142rpx; animation: hop 1.4s ease-in-out infinite; }
.pet.s3 { animation: sway 2.6s ease-in-out infinite; }
.pet.s4 { animation: sway 2.6s ease-in-out infinite; }
.pet.s5 { animation: spinGlow 4s linear infinite; }
@keyframes wob { 0%,100% { transform: rotate(-6deg); } 50% { transform: rotate(6deg); } }
@keyframes hop { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-35rpx); } }
@keyframes sway { 0%,100% { transform: translateX(-15rpx) rotate(-3deg); } 50% { transform: translateX(15rpx) rotate(3deg); } }
@keyframes spinGlow { 0% { transform: rotate(0) scale(1); } 50% { transform: rotate(180deg) scale(1.08); } 100% { transform: rotate(360deg) scale(1); } }
/* 配饰 */
.pet-halo { position: absolute; top: -27rpx; font-size: 50rpx; animation: tw 2.4s ease-in-out infinite; }
.pet-crown { position: absolute; top: -58rpx; font-size: 65rpx; animation: bob 2s ease-in-out infinite; }
.pet-scarf { position: absolute; bottom: 35rpx; font-size: 58rpx; }
.pet-medal { position: absolute; top: -8rpx; right: -23rpx; font-size: 42rpx; animation: tw 2.4s ease-in-out infinite; }
/* 破壳（s2）：壳贴在宠物下半部脚边 —— 原先悬在头顶与未领养「蛋蛋」符号冲突（P2 打磨定稿） */
.pet-shell { position: absolute; bottom: -4rpx; font-size: 50rpx; }
.pet-cheek { position: absolute; bottom: 50rpx; width: 29rpx; height: 19rpx; border-radius: 50%; background: rgba(255, 138, 148, .5); }
.pet-cheek.l { left: 15%; }
.pet-cheek.r { right: 15%; }
/* 传奇翅膀（s5）：纯 CSS 渐变羽翼（P1 打磨定稿：原翅膀 emoji 属非基础区段 Unicode，跨机型不一致已移除）
   豁免：金色渐变端点 #c79a2e / rgba 金辉光 —— 与原型 v2.4 金色系一致（同 .topcard .unit 的 #c79a2e） */
.pet-wing {
  position: absolute; top: 44rpx; width: 64rpx; height: 96rpx;
  pointer-events: none;
  background: linear-gradient(155deg, var(--sun) 0%, var(--star) 55%, #c79a2e 100%);
  border-radius: 100% 16% 74% 16% / 62% 22% 88% 30%;
  box-shadow: inset 0 -10rpx 14rpx rgba(199, 154, 46, .4);
  filter: drop-shadow(0 0 12rpx rgba(255, 201, 60, .65));
  animation: flutter 1.8s ease-in-out infinite;
}
/* 内层羽片 ×2：叠出羽毛层次（豁免：白色高光/浅金 rgba，与原型 v2.4 玻璃高光同源） */
.pet-wing::before {
  content: ''; position: absolute; left: 16%; top: 16%; width: 56%; height: 50%;
  background: linear-gradient(155deg, rgba(255, 255, 255, .85), rgba(255, 230, 160, .5));
  border-radius: 100% 16% 74% 16% / 62% 22% 88% 30%;
}
.pet-wing::after {
  content: ''; position: absolute; left: 6%; bottom: 6%; width: 64%; height: 40%;
  background: linear-gradient(155deg, rgba(255, 230, 160, .9), rgba(199, 154, 46, .55));
  border-radius: 100% 16% 74% 16% / 62% 22% 88% 30%;
}
/* 左翅镜像：animation 会整体覆盖 transform，故镜像写进专属 keyframes（flutter-l），不能只靠 scaleX(-1) */
.pet-wing.l { left: -46rpx; animation-name: flutter-l; }
.pet-wing.r { right: -46rpx; }
@keyframes flutter { 0%,100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-12rpx) rotate(4deg); } }
@keyframes flutter-l { 0%,100% { transform: scaleX(-1) translateY(0) rotate(-4deg); } 50% { transform: scaleX(-1) translateY(-12rpx) rotate(4deg); } }
@keyframes tw { 0%,100% { transform: scale(.8) rotate(-6deg); opacity: .5; } 50% { transform: scale(1.15) rotate(6deg); opacity: 1; } }
.pet-tip { margin-top: 12rpx; font-size: 23rpx; color: #e8762f; }
.pet-banner {
  display: inline-block; margin-top: 15rpx;
  background: linear-gradient(135deg, var(--star), var(--coral));
  color: #fff; font-weight: 800; font-size: 25rpx;
  padding: 8rpx 27rpx; border-radius: 999rpx; box-shadow: var(--shadow-sm);
}

/* 技能按钮（王者荣耀风格）—— 位于成长瓶与心情瓶之间，底部对齐 */
/* 豁免：与原型 v2.4 一致 —— 本区块硬编码色（白圈边框、银白径向渐变、立体阴影、费用橙 #e8762f）均为定稿色 */
.skills { display: flex; gap: 58rpx; justify-content: center; align-items: flex-end; }
.skills-empty { width: 342rpx; }   /* 未领养：中间留空，两瓶仍在 */
.skill { display: flex; flex-direction: column; align-items: center; gap: 13rpx; }
.skill .ring {
  position: relative; width: 142rpx; height: 142rpx; border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, .92);
  background: radial-gradient(circle at 50% 30%, #ffffff, #dde6f4);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 13rpx 31rpx rgba(60, 70, 110, .28), inset 0 -12rpx 23rpx rgba(0, 0, 0, .14);
}
.skill:active .ring { transform: scale(.9); }
.skill .ic { font-size: 58rpx; line-height: 1; }
.skill .cost { position: absolute; bottom: 8rpx; font-weight: 800; font-size: 19rpx; color: #e8762f; }
.skill .nm { font-weight: 700; font-size: 25rpx; color: var(--ink); }
.skill.disabled { opacity: .5; }
.skill.disabled .ring { filter: grayscale(.55); }

/* 框外操作 */
/* 豁免：与原型 v2.4 一致 —— 管理入口玫瑰灰 #b08a9a */
.acts { margin-top: 31rpx; }
.adopt-btn { width: 100%; font-size: 35rpx; border-radius: 35rpx; padding: 29rpx; }
.manage-row { display: flex; justify-content: center; }
.manage-btn {
  color: #b08a9a; font-size: 25rpx; font-weight: 700;
  display: inline-flex; align-items: center; gap: 10rpx;
}
.manage-hint { text-align: center; font-size: 25rpx; color: var(--ink-soft); }
.btn-lav { background: linear-gradient(135deg, var(--lav), var(--peach)); }

/* 弹层内部 */
/* 豁免：与原型 v2.4 一致 —— 物种格子浅紫底 #f6f4fb */
.pet-grid { display: flex; flex-wrap: wrap; gap: 19rpx; margin: 12rpx 0 8rpx; }
.pet-grid .pg {
  width: 120rpx; height: 120rpx; border-radius: 31rpx;
  border: 4rpx solid var(--line); background: #f6f4fb;
  font-size: 65rpx; display: flex; align-items: center; justify-content: center;
}
.pet-grid .pg.on { background: var(--sun); border-color: var(--coral); box-shadow: var(--shadow-sm); }
.fl-label { display: block; font-size: 25rpx; color: var(--ink-soft); margin-bottom: 10rpx; font-weight: 700; }
.mg-tip { margin-top: 0; text-align: left; }

/* 互动统计 */
/* 豁免：与原型 v2.4 一致 —— 统计卡白底 #fff、进度轨道浅紫 #f0eef7、成长/心情条渐变端点 */
.stats2 { display: flex; flex-wrap: wrap; gap: 19rpx; }
.st2 {
  width: calc(50% - 10rpx); display: flex; align-items: center; gap: 19rpx;
  background: #fff; border-radius: 31rpx; padding: 21rpx 23rpx; box-shadow: var(--shadow-sm);
}
.st2 .se { font-size: 46rpx; }
.st2 .sv { font-weight: 800; font-size: 35rpx; color: var(--ink); }
.st2 .sk { font-size: 21rpx; color: var(--ink-soft); }
.brow { display: flex; align-items: center; gap: 15rpx; margin-top: 19rpx; }
.brow .bl { width: 77rpx; flex: 0 0 77rpx; font-size: 25rpx; color: var(--ink-soft); font-weight: 700; }
.brow .btrack { flex: 1; height: 27rpx; background: #f0eef7; border-radius: 999rpx; overflow: hidden; }
.brow .bfill { height: 100%; border-radius: 999rpx; transition: width .5s; }
.brow .bfill.growth { background: linear-gradient(90deg, #ff5d6c, #ff9f43); }
.brow .bfill.mood { background: linear-gradient(90deg, #36d1ff, #5b6bff); }
.brow .bv { width: 50rpx; flex: 0 0 50rpx; text-align: right; font-weight: 700; font-size: 23rpx; color: var(--ink); }

/* 顶部宠物信息条的右侧编辑按钮（复用 .kidbar） */
/* 豁免：与原型 v2.4 一致 —— 白色圆钮 rgba 底 */
.pet-edit {
  flex: 0 0 auto;
  width: 65rpx; height: 65rpx; border-radius: 50%;
  background: rgba(255, 255, 255, .85);
  font-size: 31rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-sm);
}
.pet-edit:active { transform: scale(.88); }
