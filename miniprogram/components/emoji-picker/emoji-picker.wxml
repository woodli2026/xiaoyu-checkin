<!-- 点弹层外的蒙层 = 关闭；面板内 catchtap 吞掉冒泡 -->
<view wx:if="{{show}}" class="ep-mask" catchtap="onMask">
  <view class="ep-panel" catchtap="noop">
    <view class="ep-head">
      <text class="ep-title">🎨 选择图标</text>
      <text class="ep-x" catchtap="close">×</text>
    </view>

    <!-- 同 day-sheet：不用 scroll-view（它必须有确定 height，只给 max-height 会算成 0 高），
         滚动交给 .ep-panel 自身 -->
    <view class="ep-body">
      <view class="ep-grid">
        <view wx:for="{{icons}}" wx:key="*this"
              class="ep-cell {{item === current ? 'on' : ''}}"
              data-icon="{{item}}" catchtap="pick">{{item}}</view>
      </view>
    </view>

    <view class="ep-close" catchtap="close">取消</view>
  </view>
</view>
